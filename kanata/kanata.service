[Unit]
Description=Kanata keyboard remapper (home row mods)
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:%h/.local/bin
Type=simple
ExecStart=/bin/sh -c 'exec kanata --cfg %h/.config/kanata/kanata.kbd --no-wait'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
